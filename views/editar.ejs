<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Editar Ticket</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        padding: 20px;
      }
      .form-group {
        margin-bottom: 15px;
      }
      label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
      }
      input,
      select {
        width: 100%;
        padding: 8px;
        max-width: 400px;
        box-sizing: border-box;
      }
      .btn-submit {
        background: #007bff;
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
      }
      .btn-volver {
        margin-left: 10px;
        text-decoration: none;
        color: #333;
      }
      .errores {
        max-width: 400px;
        margin-bottom: 15px;
        padding: 10px 15px;
        border-left: 4px solid #dc3545;
        background: #f8d7da;
        color: #842029;
      }
      .errores ul {
        margin: 5px 0 0;
        padding-left: 20px;
      }
    </style>
  </head>
  <body>
    <h1>✏️ Editar Ticket</h1>
    <p><strong>ID:</strong> <%= ticket._id %></p>

    <% if (errores.length > 0) { %>
      <div class="errores">
        <strong>No se pudo actualizar el ticket (400):</strong>
        <ul>
          <% errores.forEach(mensaje => { %>
            <li><%= mensaje %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/tickets/<%= ticket._id %>/editar" method="POST">
      <div class="form-group">
        <label for="titulo">Problema reportado (Título):</label>
        <input type="text" id="titulo" name="titulo" value="<%= ticket.titulo %>" required />
      </div>

      <div class="form-group">
        <label for="estado">Estado:</label>
        <select id="estado" name="estado">
          <% estados.forEach(estado => { %>
            <option value="<%= estado %>" <%= ticket.estado === estado ? "selected" : "" %>>
              <%= estado %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="prioridad">Prioridad:</label>
        <select id="prioridad" name="prioridad">
          <% prioridades.forEach(prioridad => { %>
            <option
              value="<%= prioridad %>"
              <%= ticket.prioridad === prioridad ? "selected" : "" %>
            >
              <%= prioridad %>
            </option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="btn-submit">Guardar cambios</button>
      <a href="/" class="btn-volver">Cancelar</a>
    </form>
  </body>
</html>
