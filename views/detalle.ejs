<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Detalle del Ticket #<%= ticket.id %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        padding: 20px;
      }
      .card {
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 8px;
        max-width: 400px;
        background-color: #fcfcfc;
      }
      .estado {
        font-weight: bold;
        color: #007bff;
        text-transform: uppercase;
      }
      .btn-volver {
        display: inline-block;
        margin-top: 20px;
        text-decoration: none;
        color: #333;
        background: #eee;
        padding: 10px 15px;
        border-radius: 5px;
      }
      .btn-volver:hover {
        background: #ddd;
      }
    </style>
  </head>
  <body>
    <h1>🔍 Detalle del Ticket</h1>

    <div class="card">
      <p><strong>ID del Ticket:</strong> <%= ticket.id %></p>
      <p><strong>Problema reportado:</strong> <%= ticket.titulo %></p>
      <p>
        <strong>Estado actual:</strong>
        <span class="estado"><%= ticket.estado %></span>
      </p>
    </div>

    <a href="/" class="btn-volver">⬅ Volver al listado</a>
  </body>
</html>
